# =============================================================
# Julius 音声認識 文法ルール定義ファイル (test.grammar)
#
# 【文法設計】
# - 助詞（P_NO「の」、P_NI「に」、P_WO「を」）と「くらい（APPROX）」を独立させ、
#   単語辞書(test.yomi)に助詞が重複して入らないクリーンな文法構造にしています。
# =============================================================

S : NS_B SENTENCE NS_E

SENTENCE : DRAW_SENTENCE
SENTENCE : EDIT_SENTENCE

# -------------------------------------------------------------
# 1. 新しい図形を描く文 (DRAW_SENTENCE)
#    例：「真ん中に 大きい 丸を 描いてください」
#    例：「一番の 内側の 下に 半分くらいの 丸を 描いて」
# -------------------------------------------------------------
DRAW_SENTENCE : LOC_PHRASE OBJ_PHRASE ACT_PHRASE
DRAW_SENTENCE : OBJ_PHRASE ACT_PHRASE

# 参照フレーズ（「その」「そのの」または「前／一番／二番 + の」）
REF_P : REF_PRON
REF_P : REF_PRON P_NO
REF_P : TARGET_NOUN P_NO

# 位置フレーズ（通常の位置 ／ 前の図形・番号基準の位置）
LOC_PHRASE : LOC P_NI
LOC_PHRASE : TOUCH LOC P_NI
LOC_PHRASE : REF_P LOC P_NI
LOC_PHRASE : REF_P TOUCH LOC P_NI
LOC_PHRASE : REF_P REL P_NI
LOC_PHRASE : REF_P TOUCH REL P_NI
LOC_PHRASE : REF_P REL P_NO LOC P_NI
LOC_PHRASE : REF_P REL P_NO TOUCH LOC P_NI
LOC_PHRASE : REF_P TOUCH REL P_NO LOC P_NI

# 目的語フレーズ（図形 + 「を」）
OBJ_PHRASE : SHAPE_PHRASE P_WO

# 図形フレーズ（サイズ・向き・色と図形の組み合わせ：どの順番でも認識可能）
SHAPE_PHRASE : SHAPE
SHAPE_PHRASE : SIZE_P SHAPE
SHAPE_PHRASE : ASPECT_P SHAPE
SHAPE_PHRASE : COLOR_P SHAPE
SHAPE_PHRASE : SIZE_P ASPECT_P SHAPE
SHAPE_PHRASE : ASPECT_P SIZE_P SHAPE
SHAPE_PHRASE : SIZE_P COLOR_P SHAPE
SHAPE_PHRASE : COLOR_P SIZE_P SHAPE
SHAPE_PHRASE : ASPECT_P COLOR_P SHAPE
SHAPE_PHRASE : COLOR_P ASPECT_P SHAPE
SHAPE_PHRASE : SIZE_P ASPECT_P COLOR_P SHAPE
SHAPE_PHRASE : ASPECT_P SIZE_P COLOR_P SHAPE
SHAPE_PHRASE : COLOR_P SIZE_P ASPECT_P SHAPE
SHAPE_PHRASE : COLOR_P ASPECT_P SIZE_P SHAPE

# サイズ修飾（「大きい」「めっちゃ大きい」「半分の」「半分くらいの」「同じくらいの」など）
SIZE_CORE : SIZE
SIZE_CORE : SIZE P_NO
SIZE_CORE : SIZE APPROX
SIZE_CORE : SIZE APPROX P_NO
SIZE_P : SIZE_CORE
SIZE_P : DEGREE SIZE_CORE

# 縦横比修飾（「縦長」「縦長の」「横の」など）
ASPECT_P : ASPECT
ASPECT_P : ASPECT P_NO

# 色修飾（「赤い」「赤の」「緑の」など）
COLOR_P : COLOR
COLOR_P : COLOR P_NO

# 描画の動詞フレーズ（「くっつけて描いて」なども対応）
ACT_PHRASE : VERB
ACT_PHRASE : VERB PLZ
ACT_PHRASE : TOUCH VERB
ACT_PHRASE : TOUCH VERB PLZ

# -------------------------------------------------------------
# 2. 図形を動かす・回転・変更する文 (EDIT_SENTENCE)
#    例：「それを 三十度 回転してください」「二番を 赤く 塗ってください」
#    例：「一番を 半分くらいの 大きさに して」「それを 横長に して」
# -------------------------------------------------------------
EDIT_SENTENCE : EDIT_BODY
EDIT_SENTENCE : TARGET_P EDIT_BODY

# 編集対象の指定（「それを」「一番を」「二番を」など）
TARGET_P : TARGET_NOUN P_WO

# 回転する
EDIT_BODY : ANGLE EDIT_ACT

# 位置を動かす
EDIT_BODY : LOC_PHRASE EDIT_ACT

# サイズを変える（「大きくして」「半分にして」「半分くらいにして」など）
EDIT_SIZE_P : SIZE_P
EDIT_SIZE_P : SIZE P_NI
EDIT_SIZE_P : SIZE APPROX P_NI
EDIT_BODY : EDIT_SIZE_P EDIT_ACT

# 縦横比を変える（「縦長にして」「横長にして」など）
EDIT_ASPECT_P : ASPECT
EDIT_ASPECT_P : ASPECT P_NI
EDIT_BODY : EDIT_ASPECT_P EDIT_ACT

# 色を変える（「赤く塗って」「緑に塗って」「赤にして」など）
EDIT_COLOR_P : COLOR
EDIT_COLOR_P : COLOR P_NI
EDIT_BODY : EDIT_COLOR_P ACT_PHRASE
EDIT_BODY : EDIT_COLOR_P EDIT_ACT

EDIT_ACT : EDIT_VERB
EDIT_ACT : EDIT_VERB PLZ
